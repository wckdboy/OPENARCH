# Set these environment variables in your terminal. No .env file is auto-loaded.
# Keep the data directory OUTSIDE this checkout.
# OPENARCH_DATA_DIR=/private/path/balcony-projects
# FREECAD_CMD=/path/to/FreeCADCmd
# BLENDER_EXE=/path/to/blender
# TESSERACT_CMD=/path/to/tesseract
# PDFTOPPM_EXE=/path/to/pdftoppm
# Optional. Never put credentials in Git. Cloud calls require per-job opt-in too.
# OPENAI_API_KEY=
# OPENAI_MODEL=
